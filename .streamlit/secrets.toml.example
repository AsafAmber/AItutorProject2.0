# Paste into Streamlit Community Cloud > Advanced settings > Secrets.
# Use TOML syntax (quoted strings), not .env syntax. Never commit real keys.
LLM_PROVIDER = "openai"
OPENAI_API_KEY = "replace-with-your-key"
OPENAI_MODEL = "gpt-4o-mini"
TRANSLATION_PROVIDER = "tutor"
LLM_MAX_TOKENS = "1200"
LLM_TIMEOUT_SECONDS = "120"

# OpenRouter is also available from the sidebar. Set LLM_PROVIDER above to
# "openrouter" to make it the default. Omit a key to let visitors enter their own.
# OPENROUTER_API_KEY = "replace-with-your-key"
# OPENROUTER_MODEL = "openai/gpt-4o-mini"

# Optional shared storage for homework resume codes across deployments.
# HOMEWORK_PROGRESS_DATABASE_URL = "postgresql://user:password@host/database?sslmode=require"
