# Paste into Streamlit Community Cloud > Advanced settings > Secrets.
# Use TOML syntax (quoted strings), not .env syntax. Never commit real keys.
LLM_PROVIDER = "openai"
OPENAI_API_KEY = "replace-with-your-key"
OPENAI_MODEL = "gpt-4o-mini"
TRANSLATION_PROVIDER = "tutor"
LLM_MAX_TOKENS = "1200"
LLM_TIMEOUT_SECONDS = "120"

# Alternative: replace the provider/key/model above with these settings.
# LLM_PROVIDER = "openrouter"
# OPENROUTER_API_KEY = "replace-with-your-key"
# OPENROUTER_MODEL = "openai/gpt-4o-mini"
# TRANSLATION_PROVIDER = "tutor"
